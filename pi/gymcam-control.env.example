GYMCAM_CONTROL_SECRET=replace-with-the-existing-control-secret
GYMCAM_GYM_ID=replace-with-the-supabase-gym-uuid
GYMCAM_CONTROL_HOST=127.0.0.1
GYMCAM_CONTROL_PORT=8787
GYMCAM_STREAM_SERVICE=mediamtx
MEDIAMTX_SERVICE=mediamtx
MEDIAMTX_CONFIG=/etc/mediamtx.yml
MEDIAMTX_API=http://127.0.0.1:9997
MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554
GYMCAM_CAMERA_ASSIGNMENTS=/var/lib/gymcam-control/cameras.json
GYMCAM_MEDIAMTX_BACKUPS=/var/lib/gymcam-control/backups
